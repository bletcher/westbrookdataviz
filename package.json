{
  "name": "westbrookdataviz",
  "version": "1.0.0",
  "description": "Westbrook Data Visualization Apps",
  "type": "module",
  "private": true,
  "scripts": {
    "clean": "rimraf src/.observablehq/cache",
    "assets": "node scripts/generate-assets.mjs",
    "build": "observable build",
    "postbuild": "node scripts/copy-static.mjs",
    "deploy": "powershell -File deploy.ps1",
    "analytics": "node scripts/analytics.mjs",
    "dev": "observable preview",
    "invalidate-cache": "powershell -File invalidate.ps1",
    "observable": "observable"
  },
  "dependencies": {
    "@observablehq/framework": "1.13.3"
  },
  "devDependencies": {
    "@google-analytics/data": "^6.1.0",
    "rimraf": "^5.0.5",
    "sharp": "^0.34.5"
  },
  "engines": {
    "node": ">=18"
  }
}
