/* Layout Components */

.header-container {
  position: relative;
  z-index: 1000;
}

.intro-container {
  margin-top: 50px;
  margin-bottom: 10px;
  padding: 2rem;
  padding-bottom: 5px;
  max-width: var(--max-width);
  margin-left: auto;
  margin-right: auto;
  width: 100%;
  box-sizing: border-box;
  font-size: 1.2rem;
}

.cases-container {
  margin-top: 10px;
  padding: 1rem;
  max-width: var(--max-width);
  margin-left: auto;
  margin-right: auto;
  width: 100%;
  box-sizing: border-box;
}

.cases-container hr {
  margin: 0;
  padding: 0;
  border: none;
  background-color: #e7e1e1;
  height: 1px;
  width: 100%;
  max-width: var(--max-width);
  margin: 0 auto;
}

.cases-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 35px;
  margin-top: 2rem;
  width: 100%;
}

/* Typography and animations */
.down-arrow {
  display: inline-block;
  font-size: 1em;
  margin-left: 0.25em;
  animation: bounce 2s infinite;
  color: #666;
}

@keyframes bounce {
  0%, 20%, 50%, 80%, 100% {
    transform: translateY(0);
  }
  40% {
    transform: translateY(-2px);
  }
  60% {
    transform: translateY(-1px);
  }
}

/* SVG container */
.svg-container {
  width: 100%;
  max-width: 800px;
  margin: 0 auto;
  display: block;
  padding: 2rem 0;
}

.svg-container img {
  width: 100%;
  height: auto;
  display: block;
}
