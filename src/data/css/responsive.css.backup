/* Responsive Styles */

@media (max-width: 1200px) {
  .cases-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .cases-container {
    padding: 1rem;
  }
}

@media (max-width: 768px) {
  .cases-grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .cases-container {
    padding: 1rem;
    margin-top: 20px;
  }

  .case-title {
    font-size: 1.5rem;
  }

  .case-content {
    padding: 1.5rem;
  }

  .filter-buttons {
    gap: 1rem;
    flex-wrap: wrap;
  }

  .filter-button {
    font-size: 0.8rem;
    padding: 0.4rem 0.8rem;
  }

  .logo {
    font-size: 1.5rem;
  }

  .profile-image {
    float: none;
    margin: 0 auto 2rem;
    width: 250px;
  }

  .footer-content {
    flex-direction: column;
    gap: 1rem;
    text-align: center;
  }

  .social-links {
    margin-bottom: 1rem;
  }

  .intro-container {
    margin-top: 30px;
  }
}

@media (max-width: 480px) {
  .cases-container {
    padding: 0.75rem;
  }

  .case-title {
    font-size: 1.25rem;
  }

  .case-content {
    padding: 1rem;
  }

  .filter-buttons {
    gap: 0.75rem;
  }

  .logo {
    font-size: 1.0rem;
  }
}

@media (max-width: 360px) {
  .about-container {
    padding: 0 0.5rem;
  }

  .about-content {
    padding: 1.5rem;
  }

  .profile-image {
    width: 200px;
    margin: 0 auto 1.5rem;
  }

  .about-section h2 {
    font-size: 1.5rem;
  }

  .about-section p {
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .logo {
    font-size: 0.8rem;
  }

  .contact-container {
    padding: 0 0.5rem;
  }

  .contact-content {
    padding: 1.5rem;
  }

  .contact-details {
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .contact-item {
    padding: 0.75rem;
  }

  .contact-item h3 {
    font-size: 1.1rem;
  }

  .social-links {
    flex-wrap: wrap;
  }
}

/* iPhone 13 Mini and iPhone SE (375px) */
@media screen and (max-width: 375px) {
  .intro-container {
    font-size: 1.1rem;
    padding: 1.5rem;
  }

  .logo {
    font-size: 0.8rem;
  }

  .cases-grid {
    grid-template-columns: 1fr;
    gap: 1rem;
    padding: 0.5rem;
  }

  .case-card {
    padding: 0.8rem;
  }

  .case-card h3 {
    font-size: 1.1rem;
  }

  .case-card p {
    font-size: 0.9rem;
  }

  .filter-section {
    padding: 0.5rem;
  }

  .filter-button {
    padding: 0.4rem 0.8rem;
    font-size: 0.9rem;
  }

  .down-arrow {
    font-size: 1.2em;
    margin-left: 0.3em;
  }
}

/* Reduced motion for users who prefer it */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }

  .case-card-inner {
    transition: none;
  }

  .case-card p {
    opacity: 1;
    transform: none;
    transition: none;
  }

  .down-arrow {
    animation: none;
  }

  .mobile-nav,
  .nav-overlay {
    transition: none;
  }

  .hamburger span {
    transition: none;
  }
}
